index 9da17e4cc70e25d051a2e8ba24b468010094dd0f..ec5b1918431ebdf6976079c037ae7873ce582d93 100644
--- a/codex-rs/history/src/lib.rs
+++ b/codex-rs/history/src/lib.rs
@@ -372,0 +373,19 @@ impl InitialHistory {
+    /// Returns the provider recorded for the source session, when available.
+    pub fn get_model_provider(&self) -> Option<&str> {
+        self.get_rollout_items().iter().find_map(|item| match item {
+            RolloutItem::SessionMeta(meta_line) => meta_line.meta.model_provider.as_deref(),
+            _ => None,
+        })
+    }
+
+    /// Returns whether restored encrypted history came from another provider.
+    ///
+    /// Old sessions may not record a provider. Treat those histories conservatively because
+    /// encrypted response state is bound to the provider that created it.
+    pub fn has_foreign_provider_history(&self, current_provider: &str) -> bool {
+        matches!(self, Self::Resumed(_) | Self::Forked(_))
+            && self
+                .get_model_provider()
+                .is_none_or(|source_provider| source_provider != current_provider)
+    }
+
